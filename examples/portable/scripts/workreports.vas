// Checks of the daily work reports before they reach the progress certificate.
// Reads the sheets WorkReports (Date | Code | Unit | Quantity | Crew) and Budget when the document
// is a spreadsheet that has them, and the sample project otherwise. Writes one line per problem.
import { open } from './lib/office.vas';
import { records, isBlank, dateText } from './lib/table.vas';
import { budget, workReports } from './data/project.vas';

let doc = open($1);
let units = ['m', 'm2', 'm3', 'kg', 'h', 'ud'];
let codeFormat = regex(`^[A-Z]{2}[0-9]{4}$`);

// unit of every budget item, by code
let budgetUnit = {};
records(doc.input('Budget', budget)).forEach(fun(b) {
    budgetUnit.set(b.Code, b.Unit);
});

let rows = [['Row', 'Field', 'Value', 'Problem']];
let report = fun(r, field, problem) {
    let v = r.get(field);
    if (field == 'Date' && typeof v == 'number') { v = dateText(v); };
    rows.push([r._row, field, v, problem]);
};

let reports = records(doc.input('WorkReports', workReports));
reports.forEach(fun(r) {
    // dates are serial numbers in both suites: day 1 of the week is Sunday
    if (typeof r.Date != 'number') {
        report(r, 'Date', 'not a date');
    } elseif (r.Date % 7 == 1) {
        report(r, 'Date', 'Sunday: needs an overtime authorisation');
    };

    if (!codeFormat.test(`${r.Code}`)) {
        report(r, 'Code', 'expected two capital letters and four digits');
    } elseif (!budgetUnit.has(r.Code)) {
        report(r, 'Code', 'not in the budget');
    };

    if (isBlank(r.Unit)) {
        report(r, 'Unit', 'missing');
    } elseif (!units.includes(r.Unit)) {
        report(r, 'Unit', `unknown unit, expected one of ${units.join(', ')}`);
    } elseif (budgetUnit.has(r.Code) && budgetUnit.get(r.Code) != r.Unit) {
        report(r, 'Unit', `the budget measures this item in ${budgetUnit.get(r.Code)}`);
    };

    if (typeof r.Quantity != 'number') {
        report(r, 'Quantity', 'not a number');
    } elseif (r.Quantity <= 0) {
        report(r, 'Quantity', 'must be greater than zero');
    };

    if (isBlank(r.Crew)) {
        report(r, 'Crew', 'missing');
    };
});

let out = doc.report('Work report checks', `${reports.length} reports, ${rows.length - 1} problems`);
out.section('Problems');
if (rows.length == 1) {
    out.line('Every report is correct.');
} else {
    out.table(rows);
};
return out.done();
