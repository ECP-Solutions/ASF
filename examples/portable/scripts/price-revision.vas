// Price revision with a polynomial formula, Kt = a + b * Lt/L0 + c * Mt/M0 + d * Et/E0,
// where L, M and E are the labour, materials and energy indices and 0 marks the tender date.
// The coefficients belong to the contract: change them here, the hosts stay as they are.
// Reads the sheet PriceIndices (Period | Certified | Labour | Materials | Energy; first row: the
// indices at the tender date) when the document is a spreadsheet that has it, the sample otherwise.
import { open } from './lib/office.vas';
import { records, roundTo, round2, show } from './lib/table.vas';
import { priceIndices } from './data/project.vas';

let formula = { fixed: 0.15, labour: 0.40, materials: 0.30, energy: 0.15 };
if (round2(formula.fixed + formula.labour + formula.materials + formula.energy) != 1) {
    throw 'the coefficients of the formula must add up to 1';
};

let doc = open($1);
let periods = records(doc.input('PriceIndices', priceIndices));
let base = periods[1];
// contracts state Kt with three decimals
let kt = fun(r) {
    return roundTo(formula.fixed
                   + formula.labour * r.Labour / base.Labour
                   + formula.materials * r.Materials / base.Materials
                   + formula.energy * r.Energy / base.Energy, 3);
};

let rows = [['Period', 'Certified', 'Kt', 'Revised', 'Adjustment']];
let certified = 0;
let revised = 0;
for (let i = 2, i <= periods.length, i += 1) {
    let r = periods[i];
    let k = kt(r);
    let amount = round2(r.Certified * k);
    certified = certified + r.Certified;
    revised = revised + amount;
    rows.push([r.Period, r.Certified, k, amount, round2(amount - r.Certified)]);
};
rows.push(['TOTAL', round2(certified), '', round2(revised), round2(revised - certified)]);

let out = doc.report('Price revision', `Kt = ${show(formula.fixed)} + ${show(formula.labour)} Lt/L0 + ${show(formula.materials)} Mt/M0 + ${show(formula.energy)} Et/E0`);
out.section('Revision by period');
out.table(rows);
out.line(`Adjustment to pay: ${show(round2(revised - certified))}`);
return out.done();
