// Price revision with a polynomial formula, Kt = a + b * Lt/L0 + c * Mt/M0 + d * Et/E0,
// where L, M and E are the labour, materials and energy indices and 0 marks the tender date.
// The coefficients belong to the contract: change them here, the hosts stay as they are.
// Input  ($1): Period | Certified | Labour | Materials | Energy   (first row: indices at the tender date)
// Output:      Period | Certified | Kt | Revised | Adjustment   (one line per period, then the totals)
import { records } from './lib/table.vas';

// half away from zero (Math.round rounds half to even, as VBA does)
fun roundTo(x, decimals) {
    let f = 10 ^ decimals;
    if (x < 0) {
        return -Math.floor(-x * f + 0.5) / f;
    };
    return Math.floor(x * f + 0.5) / f;
};

fun round2(x) {
    return roundTo(x, 2);
};

let formula = { fixed: 0.15, labour: 0.40, materials: 0.30, energy: 0.15 };
if (round2(formula.fixed + formula.labour + formula.materials + formula.energy) != 1) {
    throw 'the coefficients of the formula must add up to 1';
};

let rows = records($1);
let base = rows[1];
let out = [['Period', 'Certified', 'Kt', 'Revised', 'Adjustment']];
let certified = 0;
let revised = 0;

for (let i = 2, i <= rows.length, i += 1) {
    let r = rows[i];
    // contracts state Kt with three decimals
    let kt = roundTo(formula.fixed
                     + formula.labour * r.Labour / base.Labour
                     + formula.materials * r.Materials / base.Materials
                     + formula.energy * r.Energy / base.Energy, 3);
    let amount = round2(r.Certified * kt);
    certified = certified + r.Certified;
    revised = revised + amount;
    out.push([r.Period, r.Certified, kt, amount, round2(amount - r.Certified)]);
};

out.push(['TOTAL', round2(certified), '', round2(revised), round2(revised - certified)]);
return out;
