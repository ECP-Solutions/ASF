// Budget summary: items, amount and share of every chapter of a bill of quantities.
// Reads the sheet Budget (Chapter | Code | Description | Unit | Quantity | UnitPrice) when the
// document is a spreadsheet that has it, and the sample project otherwise.
import { open } from './lib/office.vas';
import { records, round2, show } from './lib/table.vas';
import { budget } from './data/project.vas';

let doc = open($1);
let items = records(doc.input('Budget', budget));
let chapters = [];
let amounts = {};
let counts = {};
let total = 0;
items.forEach(fun(it) {
    let amount = it.Quantity * it.UnitPrice;
    if (!amounts.has(it.Chapter)) {
        chapters.push(it.Chapter);
        amounts.set(it.Chapter, 0);
        counts.set(it.Chapter, 0);
    };
    amounts.set(it.Chapter, amounts.get(it.Chapter) + amount);
    counts.set(it.Chapter, counts.get(it.Chapter) + 1);
    total = total + amount;
});

let rows = [['Chapter', 'Items', 'Amount', 'Share %']];
chapters.forEach(fun(ch) {
    rows.push([ch, counts.get(ch), round2(amounts.get(ch)), round2(100 * amounts.get(ch) / total)]);
});
rows.push(['TOTAL', items.length, round2(total), 100]);

let out = doc.report('Budget summary', `${items.length} items in ${chapters.length} chapters`);
out.section('Amount by chapter');
out.table(rows);
out.line(`Total budget: ${show(round2(total))}`);
return out.done();
